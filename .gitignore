# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# editors
.vscode/
.idea/
*.swp
*.swo
*~

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# verification artifacts
scripts/*.png
/test-results/
/playwright-report/

# local agent permission state
.claude/settings.local.json

# generated: mirrored from content/ by scripts/sync-content-assets.mjs
/public/content/

# Claude Code's local settings and scratch. Plans are NOT ignored: they are
# committed to docs/plans/ so the reasoning stays with the repo (AGENTS.md).
.claude
